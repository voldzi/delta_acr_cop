{
  "name": "delta-acr-cop",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.33.0",
  "scripts": {
    "build": "pnpm -r --if-present build",
    "dev": "pnpm --parallel --filter @cop/cop-api --filter @cop/cop-web --filter @cop/cop-chat dev",
    "dev:api": "pnpm --filter @cop/cop-api dev",
    "dev:chat": "pnpm --filter @cop/cop-chat dev",
    "dev:mcp": "pnpm --filter @cop/cop-mcp-gateway dev",
    "dev:web": "pnpm --filter @cop/cop-web dev",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:contracts": "vitest run tests/contract packages/nato-symbol-renderer/test",
    "lint": "tsc -b --pretty false",
    "openapi:sync-yaml": "node scripts/sync-openapi-yaml.mjs",
    "validate:openapi": "redocly lint openapi/openapi.json",
    "validate:schemas": "tsx scripts/validate-schemas.ts",
    "check": "pnpm validate:schemas && pnpm validate:openapi && pnpm lint && pnpm test"
  },
  "devDependencies": {
    "@redocly/cli": "^2.35.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^24.13.2",
    "@types/pg": "^8.20.0",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "jsdom": "^29.1.1",
    "tsx": "^4.22.4",
    "typescript": "^6.0.3",
    "vite": "^8.1.0",
    "vitest": "^4.1.9"
  },
  "dependencies": {
    "@fastify/cors": "^11.1.0",
    "@fastify/sensible": "^6.0.3",
    "@fastify/websocket": "^11.2.0",
    "@sinclair/typebox": "^0.34.41",
    "ajv": "^8.17.1",
    "ajv-formats": "^3.0.1",
    "fastify": "^5.9.0",
    "lucide-react": "^1.22.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "yaml": "^2.8.2",
    "zod": "^4.1.13"
  },
  "pnpm": {
    "overrides": {
      "matrix-events-sdk": "2.0.0"
    }
  }
}
