{
  "name": "delta-acr-cop",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.33.0",
  "scripts": {
    "build": "pnpm -r --if-present build",
    "dev": "pnpm --parallel --filter @cop/cop-api --filter @cop/cop-web --filter @cop/cop-chat dev",
    "dev:api": "pnpm --filter @cop/cop-api dev",
    "dev:chat": "pnpm --filter @cop/cop-chat dev",
    "dev:mcp": "pnpm --filter @cop/cop-mcp-gateway dev",
    "dev:web": "pnpm --filter @cop/cop-web dev",
    "test": "vitest run",
    "test:load:stream": "node scripts/load-test-stream.mjs",
    "test:watch": "vitest",
    "test:contracts": "vitest run tests/contract packages/nato-symbol-renderer/test",
    "typecheck": "tsc -b --pretty false",
    "lint": "pnpm typecheck && pnpm lint:eslint",
    "lint:eslint": "eslint . --max-warnings=0",
    "format": "prettier --write package.json pnpm-workspace.yaml tsconfig.json tsconfig.base.json vitest.config.ts eslint.config.js apps/cop-web apps/cop-chat packages/geo-client packages/messaging scripts/check-bundle-budgets.mjs scripts/check-static-runtime.mjs --ignore-unknown",
    "format:check": "prettier --check package.json pnpm-workspace.yaml tsconfig.json tsconfig.base.json vitest.config.ts eslint.config.js apps/cop-web apps/cop-chat packages/geo-client packages/messaging scripts/check-bundle-budgets.mjs scripts/check-static-runtime.mjs --ignore-unknown",
    "check:bundles": "node scripts/check-bundle-budgets.mjs",
    "check:static-runtime": "node scripts/check-static-runtime.mjs",
    "check:release": "pnpm build && pnpm check:bundles && pnpm check:static-runtime",
    "openapi:sync-yaml": "node scripts/sync-openapi-yaml.mjs",
    "validate:openapi": "redocly lint openapi/openapi.json",
    "validate:schemas": "tsx scripts/validate-schemas.ts",
    "check": "pnpm validate:schemas && pnpm validate:openapi && pnpm format:check && pnpm lint && pnpm test"
  },
  "devDependencies": {
    "@redocly/cli": "^2.51.2",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^24.13.3",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "eslint": "^10.10.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.6",
    "jsdom": "^30.0.1",
    "prettier": "^3.9.6",
    "tsx": "^4.23.13",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.69.0",
    "vite": "^8.2.2",
    "vitest": "^5.0.0"
  },
  "dependencies": {
    "@fastify/compress": "^9.2.0",
    "@fastify/cors": "^11.3.0",
    "@fastify/helmet": "^13.1.1",
    "@fastify/rate-limit": "^11.2.0",
    "@fastify/sensible": "^6.0.5",
    "@fastify/under-pressure": "^9.1.0",
    "@fastify/websocket": "^11.3.0",
    "@sinclair/typebox": "^0.34.52",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "fastify": "^5.12.3",
    "lucide-react": "^1.41.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "yaml": "^2.9.0",
    "zod": "^4.5.4"
  }
}
