FROM node:24-alpine AS base
WORKDIR /app
RUN corepack enable

FROM base AS deps
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml tsconfig.base.json tsconfig.json ./
COPY apps/cop-edge-node/package.json apps/cop-edge-node/package.json
COPY packages/canonical-model/package.json packages/canonical-model/package.json
RUN pnpm install --frozen-lockfile

FROM deps AS build
COPY apps/cop-edge-node apps/cop-edge-node
COPY packages/canonical-model packages/canonical-model
RUN pnpm --filter @cop/cop-edge-node... build

FROM node:24-alpine AS runtime
WORKDIR /app
RUN corepack enable
COPY --from=build /app ./
ENV COP_EDGE_HOST=0.0.0.0
ENV COP_EDGE_PORT=4312
ENV COP_EDGE_DATA_DIR=/data/edge
EXPOSE 4312
CMD ["pnpm", "--filter", "@cop/cop-edge-node", "start"]
