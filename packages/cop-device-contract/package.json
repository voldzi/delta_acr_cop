    "./schemas/*": "./schemas/*",
    "./fixtures/*": "./fixtures/*"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "validate": "tsx scripts/validate-fixtures.ts"
  },
  "devDependencies": {
    "ajv": "^8.18.0",
    "ajv-formats": "^3.0.1",
    "tsx": "^4.21.0",
    "typescript": "^6.0.3"
  }
}
