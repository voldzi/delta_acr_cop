FROM node:24-alpine AS base
WORKDIR /app
RUN corepack enable

FROM base AS deps
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml tsconfig.base.json tsconfig.json ./
COPY apps/cop-web/package.json apps/cop-web/package.json
RUN pnpm install --frozen-lockfile

FROM deps AS build
COPY apps/cop-web apps/cop-web
ARG VITE_COP_API_BASE_URL=http://localhost:4310
ARG VITE_COP_PUBLIC_LAB_VALUE=dev-lab-token
ARG VITE_COP_REFRESH_MS=5000
ARG VITE_COP_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
ARG VITE_COP_TILE_ATTRIBUTION="&copy; OpenStreetMap contributors"
ARG VITE_COP_MAP_CENTER=14.42,50.08
ARG VITE_COP_MAP_ZOOM=8
ENV VITE_COP_API_BASE_URL=${VITE_COP_API_BASE_URL}
ENV VITE_COP_PUBLIC_LAB_VALUE=${VITE_COP_PUBLIC_LAB_VALUE}
ENV VITE_COP_REFRESH_MS=${VITE_COP_REFRESH_MS}
ENV VITE_COP_TILE_URL=${VITE_COP_TILE_URL}
ENV VITE_COP_TILE_ATTRIBUTION="${VITE_COP_TILE_ATTRIBUTION}"
ENV VITE_COP_MAP_CENTER=${VITE_COP_MAP_CENTER}
ENV VITE_COP_MAP_ZOOM=${VITE_COP_MAP_ZOOM}
RUN pnpm --filter @cop/cop-web build

FROM node:24-alpine AS runtime
WORKDIR /app
RUN corepack enable
COPY --from=build /app ./
ENV COP_WEB_PORT=4311
EXPOSE 4311
CMD ["pnpm", "--filter", "@cop/cop-web", "preview"]
