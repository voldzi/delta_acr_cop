COP_COMMUNICATION_RETENTION_POLICY_ID=cop-communication-retention-90d-30d-180d-v1
# Dedicated report evidence key. Generate only as part of an approved deployment, never reuse the web session key.
COP_COMMUNICATION_EVIDENCE_SECRET=

# Prepared scoped Jizda disconnect. Shared csm-mobile is not app-scope proof.
# Historical compatibility source only; keep disabled and client empty.
# Current Jizda uses csm-mobile + explicit_host_consent. Future installation
# PoP grant/revocation requires a separately accepted contract and provider proof.
COP_JIZDA_DISCONNECT_ENABLED=false
COP_JIZDA_OIDC_CLIENT_ID=

# Source candidate: whole COP erasure is separate from Jizda unlink.
# All 11 provider adapters + explicit retention/restore acceptance are required.
# After the first accepted operation keep the secret/guard/checkpoints during rollback.
COP_ACCOUNT_ERASURE_ENABLED=false
# Exact controlled Edge owner, internal server-to-server only. Leave unset until
# the Edge guard and shared whole-account acceptance are deployed. Existing
# COP_EDGE_ADMIN_TOKEN is reused server-side; no browser credential or public port.
COP_ACCOUNT_ERASURE_EDGE_URL=
# Configuring this secret also installs persistent PostgreSQL stream admission
# and per-change source provenance even while erasure intake remains disabled.
# Historical stream rows without provenance remain pending; no text-based adoption.
COP_ACCOUNT_ERASURE_SECRET=
# Future native guard binding, not supported/accepted by the current legacy helper.
# Do not enable erasure using these labels alone. Stable DB identity is provisioned separately.
# Enabling erasure or retaining GUARD_REQUIRED requires the explicitly selected
# continuity implementation. native_v1 loads /opt/cop-account-safety; database_v2
# requires independent DB enrollment. Missing either fails closed. No v3->v4 migration.
COP_ACCOUNT_SAFETY_GUARD_REQUIRED=false
COP_ACCOUNT_SAFETY_AUTHORITY_MODE=native_v1
# Explicit ADR0055 alternative; never selected automatically after a failure.
# database_v2 requires independent PostgreSQL with verified TLS and reviewed
# enrollment. No application/guard DB co-restore. Empty values deny startup.
COP_ACCOUNT_SAFETY_GUARD_DATABASE_URL=
# database_v2 guard: haproxy.home.cz:5000/cop_account_safety_guard with
# sslmode=verify-full&sslrootcert=/etc/vcode-cop-pgbouncer/postgres-ca.crt.
# Unix business routing stays unchanged. Readback uses the existing verified
# COP_STREAM_BUS_DATABASE_URL TCP route to the same actual COP database.
COP_ACCOUNT_SAFETY_GUARD_STORE_ID=
COP_ACCOUNT_SAFETY_INCARNATION_ID=
COP_ACCOUNT_SAFETY_STORE_ID=
COP_ACCOUNT_SAFETY_RUNTIME_ATTESTATION=
# Dedicated server-side Keycloak erasure authority; never a user's bearer.
# V1 authority permits only COP grant revocation, preserving the shared identity.
# Shared deletion requires the separate v2 flag, fresh reset binding and actual DELETE/readback acceptance.
COP_KEYCLOAK_ERASURE_CLIENT_ID=
COP_KEYCLOAK_ERASURE_CLIENT_SECRET=
# New clean lifecycle: v2 deletes the shared identity, including SIM access.
# Blank retains previous v1 semantics; intake is disabled by default. Never reuse an accepted v1 store.
COP_USER_RESET_EPOCH=
COP_USER_RESET_TOKENS_NOT_BEFORE=
COP_ACCOUNT_ERASURE_SCOPE=
COP_KEYCLOAK_SHARED_IDENTITY_DELETE_ACCEPTED=false
COP_KEYCLOAK_COP_SCOPE_AUTHORITY_ACCEPTED=false
# Dedicated internal erasure origins/credentials; ordinary Router/measurement
# tokens are never used as a fallback. No production secret is created here.
# Existing COP_AI_CHAT_ROUTER_USER_ID_SECRET retains the exact old user derivation.
COP_SIM_ERASURE_ROUTER_URL=
COP_SIM_ERASURE_ROUTER_TOKEN=
COP_SIM_ERASURE_DRIVER_URL=
COP_SIM_ERASURE_DRIVER_TOKEN=
COP_SIM_ERASURE_ACTOR_SECRET=
# Existing LiveKit credentials are reused only at an explicitly trusted HTTPS admin endpoint.
COP_LIVEKIT_ADMIN_URL=
# Explicit alternative via existing HTTPS Messaging API; mutually exclusive
# with ADMIN_URL. Reuses server-only Messaging token and LiveKit credentials.
# The relay requires its own explicit enablement and exact durable actor fence.
COP_LIVEKIT_ERASURE_RELAY_URL=
