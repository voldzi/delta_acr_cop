COP_DATABASE_URL=
# Administrator-declared business path: direct | session | transaction; default direct.
# Hostnames/ports do not prove the broker mode; validate it separately before rollout.
COP_DATABASE_POOL_MODE=direct
# Direct/session path for Dispatch and Safety session advisory leases.
# Required in transaction mode: explicit PostgreSQL URI with host/port/database, on a
# different normalized host/port/database endpoint than COP_DATABASE_URL; no fallback.
# Explicit port prevents PGPORT/default ambiguity. Transaction URIs reject fragments
# and query endpoint overrides: host, hostaddr, port, database, dbname, service.
# Route to the same logical database/identity and retain verified TLS/authentication.
# Narrow Unix main transaction URI: encoded absolute socket-directory authority,
# explicit port/database (approved deployment port 6432), sslmode=disable; optional application_name.
# Reject duplicate/case-variant query keys and dot-segment paths; no TCP frontend.
# With that Unix main, lease/PG stream URIs require TCP + sslmode=verify-full and
# canonical absolute sslrootcert path; approved single-file mount below; no SSL overrides.
# Approved CA mount: /etc/vcode-cop-pgbouncer/postgres-ca.crt.
# Infrastructure owns actual secrets, protected socket permissions/runtime GID and
# the read-only single-file CA mount. URI SSL replaces the full inherited ssl object.
# In transaction mode the measurement consent store also uses this verified route,
# preserving its statement_timeout=15000/query_timeout=20000 and existing SQL.
# In direct/session mode consent keeps the exact main URL, even with a lease override.
# Synthetic shape only, not a runnable or deployed configuration:
# COP_DATABASE_URL=postgresql://fixture_user@%2Frun%2Ffixture-cop-pgbouncer:6432/cop_fixture?sslmode=disable
# COP_LEASE_DATABASE_URL=postgresql://fixture_user@postgres.fixture.invalid:5432/cop_fixture?sslmode=verify-full&sslrootcert=%2Fetc%2Fvcode-cop-pgbouncer%2Fpostgres-ca.crt
COP_LEASE_DATABASE_URL=
# Historical default retained: Unix IPC disable does not weaken URI-scoped remote TLS.
COP_DATABASE_SSL=false
COP_DATABASE_SSL_REJECT_UNAUTHORIZED=true
COP_DATABASE_POOL_MAX=5
COP_DATABASE_CONNECT_TIMEOUT_MS=5000
COP_DATABASE_IDLE_TIMEOUT_MS=30000
