FROM node:24-alpine AS base
WORKDIR /app
RUN corepack enable

FROM base AS deps
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml tsconfig.base.json tsconfig.json ./
COPY apps/cop-api/package.json apps/cop-api/package.json
COPY apps/cop-edge-node/package.json apps/cop-edge-node/package.json
COPY apps/cop-web/package.json apps/cop-web/package.json
COPY packages packages
RUN pnpm install --frozen-lockfile

FROM deps AS build
COPY docs docs
COPY apps apps
COPY scripts scripts
RUN pnpm --workspace-concurrency=1 --filter @cop/cop-api... build

FROM node:24-alpine AS runtime
WORKDIR /app
ENV NODE_ENV=production
ENV COP_API_PORT=4310
RUN corepack enable
COPY --from=build /app ./
EXPOSE 4310
CMD ["pnpm", "--filter", "@cop/cop-api", "start"]
