+final class ManagedVehicleAuthorityTests: XCTestCase {
+    override func tearDown() { VehicleAuthorityURLProtocol.reset(); super.tearDown() }
+    private func fixture(serverEpoch: Int = 1, wrongNativeIdentity: Bool = false, status: Int = 200) async throws
+        -> (COPManagedVehicleAudienceChecker, Conversation, MatrixLocalStoreScope) {
+        var bootstrap = try await PreviewCopAPIClient().messagingBootstrap(deviceId: "synthetic-device")
+        bootstrap.providerId = "csm.messaging"; bootstrap.userId = "@a:matrix.test"
+        let scope = try XCTUnwrap(MatrixLocalStoreScope(bootstrap))
+        let items = try await PreviewCopAPIClient().conversations()
+        var conversation = try XCTUnwrap(items.first)
+        let actor = "00000000-0000-4000-8000-000000000001"
+        let vehicle = "00000000-0000-4000-8000-000000000002"
+        conversation.conversationId = "conv_vehicle_" + vehicle
+        conversation.members = [.init(userId: actor)]
+        conversation.matrix = .init(roomId: "!vehicle:matrix.test", state: "active", encrypted: true)
+        conversation.metadata = ["scope": "shared_vehicle", "externalId": vehicle,
+            "vehicleMembershipRevision": "3", "vehicleRecipientEpoch": "1"]
+        let boundConversation = conversation
+        let issuer = AppConfiguration.fromBundle().oidcIssuer.absoluteString
+        let payload = try JSONSerialization.data(withJSONObject: ["iss": issuer, "sub": actor])
+        let jwt = "synthetic." + payload.base64EncodedString().replacingOccurrences(of: "+", with: "-")
+            .replacingOccurrences(of: "/", with: "_").replacingOccurrences(of: "=", with: "") + ".signature"
+        VehicleAuthorityURLProtocol.configure { request in
+            if request.url?.path == "/api/v1/messaging/matrix/identities/lookup" {
+                let lookup = MessagingIdentityLookup(contractVersion: "cop-messaging-identity-lookup-v1", providerId: "csm.messaging",
+                    actorUserId: actor, conversationId: boundConversation.conversationId,
+                    matrixRoomId: boundConversation.activeMatrixRoomId,
+                    identities: [.init(userId: actor, matrixUserId: wrongNativeIdentity ? "@b:matrix.test" : "@a:matrix.test")],
+                    unresolvedUserIds: [], validUntil: Date().addingTimeInterval(20), status: "online", warnings: [])
+                return (200, try CSMJSONCoding.encoder.encode(lookup))
+            }
+            if status != 200 { return (status, Data(#"{"error":{"code":"SYNTHETIC_UNAVAILABLE"}}"#.utf8)) }
+            let data: Data
+            if let body = request.httpBody { data = body }
+            else if let stream = request.httpBodyStream {
+                stream.open(); defer { stream.close() }
+                var bytes = Data(); var buffer = [UInt8](repeating: 0, count: 1024)
+                while stream.hasBytesAvailable { let n = stream.read(&buffer, maxLength: buffer.count); if n <= 0 { break }; bytes.append(contentsOf: buffer.prefix(n)) }
+                data = bytes
+            } else { throw URLError(.badServerResponse) }
+            let input = try JSONDecoder().decode(CSMSharedVehicleConversationRequest.self, from: data)
+            let result: [String: Any] = ["contractVersion": "cop-shared-vehicle-communication-v1", "confirmed": true,
+                "operationId": input.operationId.uuidString, "accountId": actor, "vehicleId": vehicle,
+                "membershipRevision": 3, "recipientEpoch": serverEpoch, "roomGeneration": 1,
+                "conversationId": boundConversation.conversationId, "roomId": "!vehicle:matrix.test",
+                "scope": "shared_vehicle", "historyPolicy": "from_membership", "revocation": "server_enforced",
+                "serverTimestamp": "2026-11-04T10:00:00.123Z"]
