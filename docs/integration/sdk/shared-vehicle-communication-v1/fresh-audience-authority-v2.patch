+/// Production implementation: verifies source membership and native actor mapping
+/// afresh using the authenticated COP service. Never derives authority from the
+/// cached Conversation or journal. Existing scoped-token fencing is reused;
+/// it does not initiate or authorize a voice call.
+struct COPManagedVehicleAudienceChecker: ManagedVehicleAudienceChecking {
+    let http: HTTPClient
+    func requireCurrentAudience(for conversation: Conversation, scope: MatrixLocalStoreScope) async throws {
+        guard scope.provider == "csm.messaging", conversation.isManagedVehicleConversation,
+              let vehicle = conversation.metadata["externalId"].flatMap(UUID.init(uuidString:)),
+              let revisionRaw = conversation.metadata["vehicleMembershipRevision"],
+              let revision = Int(revisionRaw), revision > 0, String(revision) == revisionRaw,
+              let epoch = conversation.managedRecipientEpoch,
+              let room = conversation.activeMatrixRoomId else { throw CancellationError() }
+        let generation = await MainActor.run { CSMCommunicationRuntime.currentCOPSessionGeneration() }
+        let lookup: MessagingIdentityLookup = try await http.postVerifiedUncached(
+            "/api/v1/messaging/matrix/identities/lookup", body: ["conversationId": conversation.conversationId])
+        guard lookup.complete, lookup.verified(for: conversation, actorUserId: lookup.actorUserId,
+                matrixUserId: scope.userID) else { throw CancellationError() }
+        let issuer = AppConfiguration.fromBundle().oidcIssuer.absoluteString
+        let sdkScope = SHA256.hash(data: Data((issuer + "\0" + lookup.actorUserId).utf8))
+            .map { String(format: "%02x", $0) }.joined()
+        let actorScope = VoiceOutboundScope(issuer: issuer, subject: lookup.actorUserId,
+            sdkScope: sdkScope, generation: generation, validateCurrent: {
+                guard CSMCommunicationRuntime.currentCOPSessionGeneration() == generation else {
+                    throw CSMCOPSessionError(.accountChanged)
+                }
+            })
+        let request = CSMSharedVehicleConversationRequest(operationId: UUID(), expectedMembershipRevision: revision)
+        let receipt: CSMSharedVehicleConversationReceipt = try await http.postVerifiedUncached(
+            "/api/v1/shared-vehicles/v1/vehicles/\(vehicle.uuidString.lowercased())/conversation",
+            body: request, scope: actorScope)
+        guard receipt.matches(accountId: receipt.accountId, vehicleId: vehicle, request: request),
+              receipt.conversationId == conversation.conversationId, receipt.roomId == room,
+              String(receipt.recipientEpoch) == epoch else { throw CancellationError() }
+    }
+}
