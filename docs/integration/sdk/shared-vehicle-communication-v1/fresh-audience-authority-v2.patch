+private actor SyntheticManagedAudience: ManagedVehicleAudienceChecking {
+    var epoch: String
+    private(set) var calls = 0
+    private var networkFailed = false
+    private var shouldPause = false
+    private var entered = false
+    private var pauseWaiter: CheckedContinuation<Void, Never>?
+    private var heldLookup: CheckedContinuation<Void, Never>?
+    func failNetwork() { networkFailed = true }
+    func pauseNext() { shouldPause = true }
+    func waitForPause() async {
+        if entered { return }
+        await withCheckedContinuation { pauseWaiter = $0 }
+    }
+    func release() { heldLookup?.resume(); heldLookup = nil }
+    init(epoch: String) { self.epoch = epoch }
+    func changeEpoch(_ value: String) { epoch = value }
+    func requireCurrentAudience(for conversation: Conversation, scope: MatrixLocalStoreScope) async throws {
+        calls += 1
+        if networkFailed { throw URLError(.networkConnectionLost) }
+        if shouldPause {
+            shouldPause = false
+            await withCheckedContinuation { continuation in
+                heldLookup = continuation
+                entered = true
+                pauseWaiter?.resume(); pauseWaiter = nil
+            }
+        }
+        guard scope.userID == "@a:matrix.test", conversation.managedRecipientEpoch == epoch else { throw CancellationError() }
+    }
+}
