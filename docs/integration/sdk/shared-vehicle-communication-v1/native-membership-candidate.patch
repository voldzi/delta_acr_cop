@@ -0,0 +1,22 @@
+import Foundation
+
+protocol ManagedVehicleNativeMembership: Sendable {
+    func requireManagedVehicleJoined(_ conversation: Conversation) async throws
+    func acceptManagedVehicleInvitation(_ conversation: Conversation) async throws
+}
+
+extension Conversation {
+    var isManagedVehicleConversation: Bool { metadata["scope"] == "shared_vehicle" }
+    var managedRecipientEpoch: String? {
+        guard isManagedVehicleConversation, let raw = metadata["vehicleRecipientEpoch"],
+              let value = UInt64(raw), value > 0, value <= 9_007_199_254_740_991,
+              String(value) == raw else { return nil }
+        return raw
+    }
+    func matchesManagedSubmission(_ submission: MatrixDraftSubmission) -> Bool {
+        if isManagedVehicleConversation {
+            return managedRecipientEpoch != nil && submission.recipientEpoch == managedRecipientEpoch
+        }
+        return submission.recipientEpoch == nil
+    }
+}
