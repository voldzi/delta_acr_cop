+    private enum CodingKeys: String, CodingKey, CaseIterable { case version, selection, target, requestedAccess, mappedEndpoint, distanceM, snapDistanceM, remainingAccess, requestHash, geometryHash, routeId, routingDataset, profileId, engine, closureRevision, validUntil }
+    public init(from decoder: Decoder) throws {
+        try arrivalKeys(decoder, Set(CodingKeys.allCases.map(\.rawValue)))
+        let c = try decoder.container(keyedBy: CodingKeys.self)
+        version = try c.decode(String.self, forKey: .version)
+        selection = try c.decode(String.self, forKey: .selection)
+        try arrivalKeys(c.superDecoder(forKey: .target), Set(["lat", "lon"]))
+        target = try c.decode(CSMRoutePoint.self, forKey: .target)
+        try arrivalKeys(c.superDecoder(forKey: .requestedAccess), Set(["lat", "lon"]))
+        requestedAccess = try c.decode(CSMRoutePoint.self, forKey: .requestedAccess)
+        try arrivalKeys(c.superDecoder(forKey: .mappedEndpoint), Set(["lat", "lon"]))
+        mappedEndpoint = try c.decode(CSMRoutePoint.self, forKey: .mappedEndpoint)
+        distanceM = try c.decode(Double.self, forKey: .distanceM)
+        snapDistanceM = try c.decode(Double.self, forKey: .snapDistanceM)
+        remainingAccess = try c.decode(String.self, forKey: .remainingAccess)
+        requestHash = try c.decode(String.self, forKey: .requestHash)
+        geometryHash = try c.decode(String.self, forKey: .geometryHash)
+        routeId = try c.decode(String.self, forKey: .routeId)
+        try arrivalKeys(c.superDecoder(forKey: .routingDataset), Set(["version", "builtAt"]))
+        routingDataset = try c.decode(CSMRoutingDataset.self, forKey: .routingDataset)
+        profileId = try c.decode(String.self, forKey: .profileId)
+        try arrivalKeys(c.superDecoder(forKey: .engine), Set(["provider", "version", "costing", "fallbackUsed"]))
+        engine = try c.decode(Engine.self, forKey: .engine)
+        closureRevision = try c.decode(String.self, forKey: .closureRevision)
+        validUntil = try c.decode(Date.self, forKey: .validUntil)
+    }
+}
+func userArrivalDistance(_ a: CSMRoutePoint, _ b: CSMRoutePoint) -> Double {
+    let rad = Double.pi / 180
+    let h = pow(sin((a.lat-b.lat)*rad/2),2) + cos(a.lat*rad)*cos(b.lat*rad)*pow(sin((a.lon-b.lon)*rad/2),2)
+    return 6_371_000 * 2 * asin(sqrt(min(1,max(0,h))))
+}
+extension CSMDriverRouteResponse {
+    func verifyingUserSelectedArrival(_ request: CSMDriverRouteRequest, at now: Date = .now) throws -> Self {
+        guard let asked = request.arrival else {
+            guard !routes.contains(where: { $0.arrival != nil }), !(features?.contains(where: {$0.properties.arrival != nil}) ?? false) else { throw CSMDriverRoutingError.invalidUserSelectedArrival }
+            return self
+        }
+        guard asked.version == "sim-user-selected-arrival-v1", asked.selection == "user_selected", asked.target.isValid,
+              request.to.isValid, request.profileId == "car", request.includeSteps,
+              request.vehicle == nil, request.vehicleProfile == nil, request.trip == nil, request.via == nil, request.departureTime == nil,
+              userArrivalDistance(request.to,asked.target) <= 250,
+              knownClosuresVerified, !requiresMapKitFallback, !routes.isEmpty, routes.count <= 3, let query, let features,
+              features.count == routes.count, Set(features.map(\.id)).count == features.count else { throw CSMDriverRoutingError.invalidUserSelectedArrival }
+        let canonical = try RoutingCanonicalJSON(), requestHash = try canonical.hash(query)
+        func samePoint(_ a: CSMRoutePoint, _ b: CSMRoutePoint) -> Bool { a.lat == b.lat && a.lon == b.lon }
+        for route in routes {
+            guard route.isNavigable, let a = route.arrival, let closure = route.knownClosures, let last = route.geometry.coordinates.last,
+                  a.version == "sim-user-selected-arrival-v1", a.selection == "user_selected", a.remainingAccess == "unverified",
+                  a.target.isValid, a.requestedAccess.isValid, a.mappedEndpoint.isValid,
+                  samePoint(a.target,asked.target), samePoint(a.requestedAccess,request.to),
+                  a.mappedEndpoint.lat == last[1], a.mappedEndpoint.lon == last[0],
+                  a.distanceM.isFinite, (0...250).contains(a.distanceM), a.snapDistanceM.isFinite, (0...25).contains(a.snapDistanceM),
+                  a.routeId == route.routeId, a.requestHash == requestHash, a.geometryHash == (try canonical.hash(route.geometry)),
+                  a.routingDataset.version == closure.routingDataset.version, a.routingDataset.builtAt == closure.routingDataset.builtAt,
+                  a.profileId == "car", a.engine.provider == "valhalla", a.engine.version == closure.engine.version,
+                  a.engine.costing == "auto", !a.engine.fallbackUsed, route.vehicleAssessment?.providerCosting == "auto",
+                  a.closureRevision == closure.revision, a.validUntil > now, a.validUntil <= closure.validUntil,
+                  let feature = features.first(where: {$0.id == route.routeId}), feature.type == "Feature", let mirrored = feature.properties.arrival,
+                  try canonical.string(mirrored) == canonical.string(a),
+                  try canonical.string(feature.geometry) == canonical.string(route.geometry) else { throw CSMDriverRoutingError.invalidUserSelectedArrival }
+            let distance = userArrivalDistance(a.mappedEndpoint,a.target), snap = userArrivalDistance(a.mappedEndpoint,a.requestedAccess)
+            guard distance <= 250, snap <= 25, abs(distance-a.distanceM) <= 0.01, abs(snap-a.snapDistanceM) <= 0.01 else { throw CSMDriverRoutingError.invalidUserSelectedArrival }
+        }
+        var verified = self; verified.userArrivalVerified = true; return verified
+    }
+    public func requireValidUserSelectedArrival(at now: Date = .now) throws {
+        guard (!routes.contains(where: {$0.arrival != nil}) && !(features?.contains(where: {$0.properties.arrival != nil}) ?? false)) ||
+                (userArrivalVerified && routes.allSatisfy({$0.arrival.map {$0.validUntil > now} == true})) else { throw CSMDriverRoutingError.invalidUserSelectedArrival }
+    }
+}
+public extension CSMCommunicationRuntime {
+    /// The caller must explicitly obtain the road access from the user. Never use this as an automatic error fallback.
+    func drivingRoutes(from: CSMRoutePoint, userSelectedAccess: CSMRoutePoint, originalTarget: CSMRoutePoint, alternatives: Int = 3) async throws -> CSMDriverRouteResponse {
+        guard from.isValid, userSelectedAccess.isValid, originalTarget.isValid else { throw CSMDriverRoutingError.invalidCoordinates }
+        guard (1...3).contains(alternatives), userArrivalDistance(userSelectedAccess,originalTarget) <= 250 else { throw CSMDriverRoutingError.unsupportedUserSelectedArrival }
+        await prepareRoutingAuthentication()
+        guard try await drivingCapabilities().userSelectedArrival?.permitsUserSelectedArrival == true else { throw CSMDriverRoutingError.unsupportedUserSelectedArrival }
+        let request = CSMDriverRouteRequest(from: from, to: userSelectedAccess, alternatives: alternatives, includeRoadAttributes: true,
+                                            arrival: .init(target: originalTarget))
+        let raw = try await driverReportService.drivingRoutes(request)
+        let checked = try await Task.detached { try raw.verifyingKnownClosures(for: request).verifyingMappedProfile(request).verifyingUserSelectedArrival(request) }.value
+        _ = try checked.navigationRoutes()
+        return checked
+    }
+}
+
+private struct ArrivalKey: CodingKey {
+    let stringValue: String
+    let intValue: Int? = nil
+    init?(stringValue: String) { self.stringValue = stringValue }
+    init?(intValue: Int) { return nil }
+}
+private func arrivalKeys(_ decoder: Decoder, _ allowed: Set<String>) throws {
+    let c = try decoder.container(keyedBy: ArrivalKey.self)
+    guard Set(c.allKeys.map(\.stringValue)) == allowed else { throw CSMDriverRoutingError.invalidUserSelectedArrival }
+}
