+public struct CSMUserSelectedArrivalRequest: Encodable, Sendable {
+    public let version = "sim-user-selected-arrival-v1"
+    public let selection = "user_selected"
+    public let target: CSMRoutePoint
+    public init(target: CSMRoutePoint) { self.target = target }
+    private enum CodingKeys: String, CodingKey { case version, selection, target }
+}
+public struct CSMUserSelectedArrivalCapabilities: Codable, Sendable {
+    public let version, availability, selection: String
+    public let profileIds: [String]
+    public let maxRemainingDistanceM, maxSnapDistanceM: Double
+    public let remainingAccess, cachePolicy: String
+    public var permitsUserSelectedArrival: Bool {
+        version == "sim-user-selected-arrival-v1" && availability == "requires_runtime_validation" &&
+        selection == "user_selected_only" && profileIds == ["car"] && maxRemainingDistanceM == 250 &&
+        maxSnapDistanceM == 25 && remainingAccess == "unverified" && cachePolicy == "no_cache"
+    }
+}
+public struct CSMUserSelectedArrival: Codable, Sendable {
+    public struct Engine: Codable, Sendable {
+        public let provider, version, costing: String
+        public let fallbackUsed: Bool
+    }
+    public let version, selection: String
+    public let target, requestedAccess, mappedEndpoint: CSMRoutePoint
+    /// Direct, unrouted remaining distance. Not a legal access claim or pedestrian ETA.
+    public let distanceM, snapDistanceM: Double
+    public let remainingAccess, requestHash, geometryHash, routeId: String
+    public let routingDataset: CSMRoutingDataset
+    public let profileId: String
+    public let engine: Engine
+    public let closureRevision: String
