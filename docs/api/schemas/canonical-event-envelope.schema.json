{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.local/acr-cop/schemas/canonical-event-envelope.schema.json",
  "title": "Canonical Event Envelope",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "eventId",
    "eventType",
    "contractVersion",
    "source",
    "correlationId",
    "producerTimestamp",
    "classification",
    "geo",
    "payload",
    "quality"
  ],
  "properties": {
    "eventId": {
      "type": "string",
      "format": "uuid"
    },
    "eventType": {
      "type": "string",
      "enum": [
        "track.created",
        "track.updated",
        "track.lost",
        "track.restored",
        "track.deleted",
        "incident.created",
        "incident.updated",
        "report.created",
        "source.status.changed"
      ]
    },
    "contractVersion": {
      "type": "string",
      "const": "cop-ingest-v1"
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sourceSystemId",
        "adapterId",
        "adapterVersion"
      ],
      "properties": {
        "sourceSystemId": {
          "type": "string",
          "minLength": 1
        },
        "sourceDeviceId": {
          "type": [
            "string",
            "null"
          ]
        },
        "adapterId": {
          "type": "string",
          "minLength": 1
        },
        "adapterVersion": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "correlationId": {
      "type": "string",
      "format": "uuid"
    },
    "producerTimestamp": {
      "type": "string",
      "format": "date-time"
    },
    "ingestTimestamp": {
      "type": "string",
      "format": "date-time",
      "description": "Server-side timestamp added by COP after receipt."
    },
    "sequence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "streamId",
        "number"
      ],
      "properties": {
        "streamId": {
          "type": "string"
        },
        "number": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "classification": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "level",
        "releasability",
        "handlingCaveats"
      ],
      "properties": {
        "level": {
          "type": "string",
          "enum": [
            "UNCLASSIFIED",
            "RESTRICTED",
            "CONFIDENTIAL",
            "SECRET"
          ]
        },
        "releasability": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        },
        "handlingCaveats": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        }
      }
    },
    "geo": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "lat",
        "lon"
      ],
      "properties": {
        "lat": {
          "type": "number",
          "minimum": -90,
          "maximum": 90
        },
        "lon": {
          "type": "number",
          "minimum": -180,
          "maximum": 180
        },
        "altitudeM": {
          "type": [
            "number",
            "null"
          ]
        },
        "accuracyM": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        }
      }
    },
    "payload": {
      "$ref": "observed-object.schema.json"
    },
    "quality": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "confidence",
        "sourceReliability",
        "informationCredibility"
      ],
      "properties": {
        "confidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "sourceReliability": {
          "type": "string",
          "enum": [
            "A",
            "B",
            "C",
            "D",
            "E",
            "F",
            "UNKNOWN"
          ]
        },
        "informationCredibility": {
          "type": "string",
          "enum": [
            "1",
            "2",
            "3",
            "4",
            "5",
            "6",
            "UNKNOWN"
          ]
        }
      }
    },
    "simulation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "synthetic"
      ],
      "properties": {
        "synthetic": {
          "type": "boolean"
        },
        "scenarioId": {
          "type": [
            "string",
            "null"
          ],
          "format": "uuid"
        },
        "blockId": {
          "type": [
            "string",
            "null"
          ]
        },
        "seed": {
          "type": [
            "integer",
            "null"
          ]
        }
      }
    },
    "signature": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "signed"
      ],
      "properties": {
        "signed": {
          "type": "boolean"
        },
        "keyId": {
          "type": [
            "string",
            "null"
          ]
        },
        "algorithm": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    }
  }
}
