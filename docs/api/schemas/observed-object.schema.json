{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.local/acr-cop/schemas/observed-object.schema.json",
  "title": "Observed Object",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "objectId",
    "objectType",
    "affiliation",
    "domain",
    "status"
  ],
  "properties": {
    "objectId": {
      "type": "string",
      "minLength": 1
    },
    "objectType": {
      "type": "string",
      "enum": [
        "AIRCRAFT",
        "UAV",
        "MISSILE_TRACK",
        "GROUND_UNIT",
        "RESCUE_ASSET",
        "INCIDENT",
        "REPORT",
        "UNKNOWN"
      ]
    },
    "affiliation": {
      "type": "string",
      "enum": [
        "FRIEND",
        "ASSUMED_FRIEND",
        "NEUTRAL",
        "UNKNOWN",
        "SUSPECT",
        "HOSTILE",
        "PENDING"
      ]
    },
    "domain": {
      "type": "string",
      "enum": [
        "AIR",
        "LAND",
        "SEA",
        "RESCUE",
        "OTHER"
      ]
    },
    "status": {
      "type": "string",
      "enum": [
        "ACTIVE",
        "INACTIVE",
        "LOST",
        "STALE",
        "CONFLICTED"
      ]
    },
    "position": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "lat": {
          "type": "number",
          "minimum": -90,
          "maximum": 90
        },
        "lon": {
          "type": "number",
          "minimum": -180,
          "maximum": 180
        },
        "altitudeM": {
          "type": [
            "number",
            "null"
          ]
        },
        "accuracyM": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        }
      }
    },
    "movement": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "speedMps": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        },
        "headingDeg": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0,
          "maximum": 360
        },
        "verticalRateMps": {
          "type": [
            "number",
            "null"
          ]
        }
      }
    },
    "speedMps": {
      "type": [
        "number",
        "null"
      ],
      "minimum": 0
    },
    "headingDeg": {
      "type": [
        "number",
        "null"
      ],
      "minimum": 0,
      "maximum": 360
    },
    "verticalRateMps": {
      "type": [
        "number",
        "null"
      ]
    },
    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "lastUpdatedAt": {
      "type": "string",
      "format": "date-time"
    },
    "synthetic": {
      "type": "boolean"
    },
    "symbol": {
      "type": "object",
      "additionalProperties": true
    },
    "provenanceIds": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "attributes": {
      "type": "object",
      "additionalProperties": true
    }
  }
}
